@using static WebApplication.Models.EncryptDecryptService;
@using System.Data;
@inject LanguageService language
@{

    bool isAuthenticated = false;
    string controller_name = string.Empty;
    string appBaseUrl = string.Empty;
    HashSet<string> permissions = null;
    DataBaseConnection SqlClass = new DataBaseConnection();
    DataTable ReportData = null;

    isAuthenticated = Convert.ToBoolean(DecryptString(Context.Request.Cookies["IsAuthenticated"]));
    controller_name = this.ViewContext.RouteData.Values["controller"].ToString();
    //string report_name = string.Empty;
    //if (controller_name == "Report")
    //{
    //    report_name = this.ViewContext.RouteData.Values["report_name"].ToString();
    //}
    if (isAuthenticated)
    {
        if (language.Getkey("language_short") == "es")
        {
            permissions = new HashSet<string>(DecryptString(Context.Request.Cookies["IdNumModule"]).Split(","));
        }
        else
        {
            permissions = new HashSet<string>(DecryptString(Context.Request.Cookies["IdNumModule"]).Split(","));
        }

    }
    ReportData = SqlClass.getReportList();

}

