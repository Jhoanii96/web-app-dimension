@model WebApplication.Controllers.LanguageSettingController.GroupIndexModel;
@inject LanguageService language;
@{
    ViewData["Title"] = language.Getkey("conf_languages_title");

    var ValueA = Model.CollectionA.Rows;
    var ValueB = Model.CollectionB.Rows;
    var ValueC = Model.CollectionC;

}


<div class="app-page-title">
    <div class="page-title-wrapper">
        <div class="page-title-heading">
            <div>
                @language.Getkey("conf_languages_title")
            </div>
        </div>
    </div>
</div>



<div class="main-card mb-3 card">
    <div class="card-body">
        <h5 class="card-title">@language.Getkey("configuration_name")</h5>
        <div class="row">
            <div class="col">
                <ul class="nav flex-column">
                    <li class="nav-item-header nav-item">@language.Getkey("filter_name")</li>
                </ul>
                <div class="row">
                    <div class="col">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <span class="nav-link coorp-color2" style="cursor: auto; padding-bottom: 0;">
                                    @language.Getkey("conf_lase_language")
                                </span>
                            </li>
                            <li>
                                <div style="margin: 0.5rem 1rem;">
                                    <select type="select" id="lase_filter_language" class="custom-select">
                                        @for (int i = 0; i < ValueB.Count; i++)
                                        {
                                            <option value="@ValueB[i]["Id"]">@(ValueB[i]["EnglishName"] + " : " + ValueB[i]["NativeName"])</option>
                                        }
                                    </select>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
            <div class="col">
                <ul class="nav flex-column">
                    <li class="nav-item-header nav-item">@language.Getkey("activity_name")</li>
                    <li class="nav-item">
                        <a id="lase_list_add_edit_language" class="nav-link coorp-color2" data-toggle="modal" data-target="#ModalLanguage">
                            <i class="nav-link-icon pe-7s-pen"> </i><span>@language.Getkey("conf_lase_add_or_edit_language")</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a id="lase_list_add_edit_sharedvariable" class="nav-link coorp-color2" data-toggle="modal" data-target="#ModalSharedResource">
                            <i class="nav-link-icon pe-7s-pen"> </i><span>@language.Getkey("conf_lase_add_or_edit_sharedresource")</span>
                        </a>
                    </li>
                    <li class="nav-item-divider nav-item"></li>
                    <li class="nav-item-btn nav-item">
                        @*<button id="lase_add_new_row" class="btn-pill btn btn-primary btn-sm" data-toggle="modal" data-target="#Modal_add_LanguageSetting"><i class="nav-link-icon pe-7s-plus"> </i> @language.Getkey("btn_add")</button>*@
                        <button id="lase_refresh_rows" onClick="refresh_lase_table()" class="btn-pill btn btn-primary btn-sm"><i class="nav-link-icon pe-7s-refresh"> </i> @language.Getkey("btn_refresh")</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>



<div class="row">

    <div class="col-lg-12">
        <div class="main-card mb-3 card">
            <div class="card-body">
                <h5 class="card-title">@language.Getkey("conf_lase_table_title")</h5>
                <table class="mb-0 table table-hover table-bordered">
                    <thead style="font-size: 12px;">
                        <tr>
                            <th>@language.Getkey("table_col_number")</th>
                            <th>@language.Getkey("conf_lase_column_name_1")</th>
                            <th>@language.Getkey("conf_lase_column_name_2")</th>
                            <th>@language.Getkey("conf_lase_column_name_3")</th>
                            <th style="width: 84px;">@language.Getkey("table_col_actions")</th>
                        </tr>
                    </thead>
                    <tbody id="lase_rows_list">
                        @for (int i = 0; i < ValueA.Count; i++)
			            {
                        <tr>
                            <th scope="row" id="row_lase_@(i + 1)_id" data-value="@ValueA[i]["Id"]">@(i + 1)</th>
                            <td style="padding: 2px;">@ValueA[i]["VariableName"]</td>
                            <td style="padding: 2px;">@ValueA[i]["ValueName"]</td>
                            <td style="padding: 2px;">@ValueA[i]["Comments"]</td>
                            <td style="padding: 2px;">
                                <div class="input-group">
                                    <button type="button" id="row_lase_btn_@(i + 1)_edr" onClick="edit_lase_row(@(i + 1))" data-toggle="modal" data-target="#Modal_edit_LanguageSetting" class="btn btn-primary btn-iconv2" style="margin-right: 2px !important;"><i class="fa fa-pen fa-w-16 fa-1x"></i></button>
                                </div>
                            </td>
                        </tr>
			            }
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>


</div>



