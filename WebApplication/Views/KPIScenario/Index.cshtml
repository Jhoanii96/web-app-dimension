                    <div class="tab-pane active" id="tab-sosy-0" role="tabpanel">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <div class="input-group" style="margin-bottom: 15px;">
                                    <input type="text" id="kpisce_source_name_add_new" placeholder="@language.Getkey("modal_sosy_input_name_1")" class="form-control">
                                    <div class="input-group-append">
                                        <button id="btn_kpisce_source_add_new" onclick="btn_kpisce_source_add_new()" class="btn btn-primary">@language.Getkey("btn_add")</button>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item-divider nav-item"></li>
                            <li class="nav-item-btn nav-item" style="padding: 0.5rem 0;">
