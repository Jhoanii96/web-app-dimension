                        </ul>
                    </div>
                    <div class="tab-pane" id="tab-sosy-1" role="tabpanel" style="max-height: 325px; overflow: auto;">
                        <h5 class="card-title">@language.Getkey("modal_sosy_title_table")</h5>
                        <table class="mb-0 table table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th>@language.Getkey("table_col_number")</th>
                                    <th>@language.Getkey("modal_sosy_column_name_1")</th>
                                    <th style="width: 85px;">@language.Getkey("table_col_actions")</th>
                                </tr>
                            </thead>
                            <tbody id="kpisce_list_edit_source">
                                <tr>
                                    <th scope="row">1</th>
