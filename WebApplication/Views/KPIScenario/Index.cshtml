@model WebApplication.Controllers.KPIScenarioController.GroupIndexModel;
@inject LanguageService language;
@{
    ViewData["Title"] = language.Getkey("dimension_kpisce_title");

    var ValueA = Model.CollectionA.Rows;
    var ValueB = Model.CollectionB.Rows;
    var ValueC = Model.CollectionC.Rows;
}


<div class="app-page-title">
    <div class="page-title-wrapper">
        <div class="page-title-heading">
            <div>
                @language.Getkey("dimension_kpisce_title")
            </div>
        </div>
    </div>
</div>



<div class="main-card mb-3 card">
    <div class="card-body">
        <h5 class="card-title">@language.Getkey("configuration_name")</h5>
        <div class="row">
            <div class="col">
                <ul class="nav flex-column">
                    <li class="nav-item-header nav-item">@language.Getkey("filter_name")</li>
                </ul>
                <div class="row">
                    <div class="col">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <span class="nav-link coorp-color2" style="cursor: auto; padding-bottom: 0;">
                                    @language.Getkey("dimension_kpisce_kpi")
                                </span>
                            </li>
                            <li>
                                <div style="margin: 0.5rem 1rem;">
                                    <select type="select" id="kpisce_filter_kpi" class="custom-select">
                                        <option value="All" selected="selected">@language.Getkey("dropdown_all")</option>
                                        @for (int i = 0; i < ValueB.Count; i++)
                                        {
                                            <option value="@ValueB[i]["Id"]">@(ValueB[i]["CategoryName"] + ": " + language.Getkey("language_short") == "es" ? ValueB[i]["KPINameEs"] : ValueB[i]["KPINameEn"])</option>
                                        }
                                    </select>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="col">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <span class="nav-link coorp-color2" style="cursor: auto; padding-bottom: 0;">
                                    @language.Getkey("dimension_kpisce_sosy")
                                </span>
                            </li>
                            <li>
                                <div style="margin: 0.5rem 1rem;">
                                    <select type="select" id="kpisce_filter_source" class="custom-select">
                                        <option value="All" selected="selected">@language.Getkey("dropdown_all")</option>
                                        @for (int i = 0; i < ValueC.Count; i++)
                                        {
                                            <option value="@ValueC[i]["Id"]">@ValueC[i]["SourceName"]</option>
                                        }
                                    </select>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
            <div class="col">
                <ul class="nav flex-column">
                    <li class="nav-item-header nav-item">@language.Getkey("activity_name")</li>
                    <li class="nav-item">
                        <a id="kpisce_list_add_edit_source" class="nav-link coorp-color2" data-toggle="modal" data-target="#ModalSource">
                            <i class="nav-link-icon pe-7s-pen"> </i><span>@language.Getkey("dimension_kpisce_add_or_edit_sosy")</span>
                        </a>
                    </li>
                    <li class="nav-item-divider nav-item"></li>
                    <li class="nav-item-btn nav-item">
                        <button id="kpisce_add_new_row" class="btn-pill btn btn-primary btn-sm" data-toggle="modal" data-target="#Modal_add_KPI_Scenario"><i class="nav-link-icon pe-7s-plus"> </i> @language.Getkey("btn_add")</button>
                        <button id="kpisce_refresh_rows" onClick="refresh_kpisce_table()" class="btn-pill btn btn-primary btn-sm"><i class="nav-link-icon pe-7s-refresh"> </i> @language.Getkey("btn_refresh")</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>



<div class="row">

    <div class="col-lg-12">
        <div class="main-card mb-3 card">
            <div class="card-body">
                <h5 class="card-title">KPI Scenario List</h5>
                <table class="mb-0 table table-hover table-bordered">
                    <thead style="font-size: 12px;">
                        <tr>
                            <th style="width: 250px;">@language.Getkey("dimension_kpisce_column_name_1")</th>
                            <th style="width: 100px;">@language.Getkey("dimension_kpisce_column_name_2")</th>
                            <th style="width: 150px;">@language.Getkey("dimension_kpisce_column_name_3")</th>
                            <th style="width: 75px;">@language.Getkey("dimension_kpisce_column_name_4")</th>
                            <th style="width: 125px;">@language.Getkey("dimension_kpisce_column_name_5")</th>
                            <th style="width: 125px;">@language.Getkey("dimension_kpisce_column_name_6")</th>
                            <th>@language.Getkey("dimension_kpisce_column_name_7")</th>
                            <th style="width: 85px;">@language.Getkey("dimension_kpisce_column_name_8")</th>
                            <th style="width: 84px;">@language.Getkey("table_col_actions")</th>
                        </tr>
                    </thead>
                    <tbody id="kpisce_rows_list">
                        @for (int i = 0; i < ValueA.Count; i++)
			            {
                        <tr>
                            <th scope="row" id="row_kpisce_@(i + 1)_id" data-value="@ValueA[i]["IdScenario"]" style="display: none;">@(i + 1)</th>
                            <td style="padding: 2px;">
                                <select type="select" id="row_kpisce_@(i + 1)_kpi" class="custom-select" style="background: none; background-color: #e9ecef;" disabled>
                                    @for (int j = 0; j < ValueB.Count; j++)
                                    {
                                        if (ValueA[i]["IdKPINum"].ToString() == ValueB[j]["IdNum"].ToString())
                                        {
                                            <option value="@ValueB[j]["Id"]" selected="selected">@(ValueB[j]["CategoryName"] + ": " + language.Getkey("language_short") == "es" ? ValueB[j]["KPINameEs"] : ValueB[j]["KPINameEn"])</option>
                                        }
                                        else
                                        {
                                            <option value="@ValueB[j]["Id"]">@(ValueB[j]["CategoryName"] + ": " + language.Getkey("language_short") == "es" ? ValueB[j]["KPINameEs"] : ValueB[j]["KPINameEn"])</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td style="padding: 2px;">
                                <select type="select" id="row_kpisce_@(i + 1)_source" class="custom-select" style="background: none; background-color: #e9ecef;" disabled>
                                    @for (int k = 0; k < ValueC.Count; k++)
                                    {
                                        if (ValueA[i]["IdSourceNum"].ToString() == ValueC[k]["IdNum"].ToString())
                                        {
                                            <option value="@ValueC[k]["Id"]" selected="selected">@ValueC[k]["SourceName"]</option>
                                        }
                                        else
                                        {
                                            <option value="@ValueC[k]["Id"]">@ValueC[k]["SourceName"]</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td style="padding: 2px;"><input id="row_kpisce_@(i + 1)_table_name" type="text" class="form-control" value="@ValueA[i]["TableName"]" disabled="disabled"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_@(i + 1)_column_name_date" type="text" class="form-control" value="@ValueA[i]["ColumnNameDate"]" disabled="disabled"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_@(i + 1)_column_name_shift" type="text" class="form-control" value="@ValueA[i]["ColumnNameShift"]" disabled="disabled"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_@(i + 1)_column_name_value" type="text" class="form-control" value="@ValueA[i]["ColumnNameValue"]" disabled="disabled"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_@(i + 1)_filter_additional" type="text" class="form-control" value="@ValueA[i]["FilterAdditional"]" disabled="disabled"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_@(i + 1)_parameters" type="text" class="form-control" value="@ValueA[i]["Parameters"]" disabled="disabled"></td>
                            <td style="padding: 2px;">
                                <div class="input-group">
                                    <button type="button" id="row_kpisce_btn_@(i + 1)_edr" onClick="edit_kpisce_row(@(i + 1))" data-toggle="modal" data-target="#Modal_edit_KPI_Scenario" class="btn btn-primary btn-iconv2" style="margin-right: 2px !important;"><i class="fa fa-pen fa-w-16 fa-1x"></i></button>
                                    <button type="button" id="row_kpisce_btn_@(i + 1)_der" onClick="delete_kpisce_row('@(i + 1). @ValueA[i]["TableName"]', @(i + 1))" class="btn btn-primary btn-iconv2"><i class="fa fa-trash fa-w-16 fa-1x"></i></button>
                                </div>
                            </td>
                        </tr>
			            }
                        

                        <tr id="kpisce_row_example_hidden" style="display: none;">
                            <th scope="row" id="row_kpisce_new_id" style="display: none;">-</th>
                            <td style="padding: 2px;">
                                <select type="select" id="row_kpisce_new_kpi" class="custom-select">
                                    @for (int i = 0; i < ValueB.Count; i++)
                                    {
                                        <option value="@ValueB[i]["Id"]">@(ValueB[i]["CategoryName"] + ": " + language.Getkey("language_short") == "es" ? ValueB[i]["KPINameEs"] : ValueB[i]["KPINameEn"])</option>
                                    }
                                </select>
                            </td>
                            <td style="padding: 2px;">
                                <select type="select" id="row_kpisce_new_source" class="custom-select">
                                    @for (int i = 0; i < ValueC.Count; i++)
                                    {
                                        <option value="@ValueC[i]["Id"]">@ValueC[i]["SourceName"]</option>
                                    }
                                </select>
                            </td>
                            <td style="padding: 2px;"><input id="row_kpisce_new_table_name" type="text" class="form-control"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_new_column_name_date" type="text" class="form-control"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_new_column_name_shift" type="text" class="form-control"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_new_column_name_value" type="text" class="form-control"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_new_filter_additional" type="text" class="form-control"></td>
                            <td style="padding: 2px;"><input id="row_kpisce_new_parameters" type="text" class="form-control"></td>
                            <td style="padding: 2px;"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


</div>



@section ModalsKPIScenario
{
<!-- Modal 5 KPISCENARIO - Source System -->
<div class="modal fade" id="ModalSource" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="card-header">
                <i class="header-icon lnr-license icon-gradient bg-plum-plate"> </i>@language.Getkey("modal_add_or_edit_sosy")
